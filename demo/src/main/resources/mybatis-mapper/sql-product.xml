<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ProductMapper">

    <select id="selectProductList" parameterType="hashmap" resultType="com.example.demo.model.Product"> 
        select *, 
            round(price) as convert_price 
        from product
        where 1=1
            and status like 'SALE'
        <if test="category != '' and category != null">
            and category = #{category}
        </if>
        <choose>
            <when test="order == 1"> order by price </when>
            <when test="order == 2"> order by price desc </when>
            <when test="order == 3"> order by release_date </when>
            <otherwise> order by product_id </otherwise>
        </choose>
    </select>

    <select id="selectProduct" parameterType="hashmap" resultType="com.example.demo.model.Product">
        select *, 
            round(price) as convert_price
        from product
        where product_id = #{productId}
    </select>

    <select id="selectCategoryList" parameterType="hashmap" resultType="com.example.demo.model.Product">
        select distinct category 
        from product
    </select>

    <update id="stopProduct" parameterType="hashmap">
        update product set
            status = 'STOP'
        where product_id = #{productId}
    </update>
    
</mapper>