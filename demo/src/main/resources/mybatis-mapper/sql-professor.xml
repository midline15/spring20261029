<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ProfessorMapper">
	<select id="selectProfessorList" parameterType="hashmap" resultType="com.example.demo.model.Professor">
		select * from professor
	</select>
	
	<delete id="deleteProfessor" parameterType="hashmap">
		delete from professor where profno = #{profNo}
	</delete>
	
	<insert id="insertProfessor" parameterType="hashmap">
		insert into professor(profno, name, position, pay)
		values(#{profNo}, #{name}, #{position}, #{pay})
	</insert>
	
	<select id="selectProfessor" parameterType="hashmap" resultType="com.example.demo.model.Professor">
		select * from professor where profno = #{profNo}
	</select>
</mapper>